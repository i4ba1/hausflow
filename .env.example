# Leave empty to run the public scaffold preview without accounts.
# For the authenticated workspace, configure all three values below.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Populated by `pnpm backend` after you select/create a development deployment.
CONVEX_DEPLOYMENT=

# Set in the Convex dashboard, NOT in the browser environment:
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
# Phase 2 only: RESEND_API_KEY, RESEND_WEBHOOK_SECRET,
# ANTHROPIC_API_KEY, ANTHROPIC_MODEL
